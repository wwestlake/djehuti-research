{
  "version": 6,
  "configurePresets": [{
    "name": "windows-debug",
    "generator": "Visual Studio 17 2022",
    "architecture": "x64",
    "binaryDir": "${sourceDir}/build",
    "cacheVariables": {
      "JUCE_PATH": "$env{JUCE_PATH}",
      "FRUSTLANG_ROOT": "$env{FRUSTLANG_ROOT}",
      "FRUST_VCPKG_INSTALLED_DIR": "$env{FRUST_VCPKG_INSTALLED_DIR}",
      "FLEX_EXECUTABLE": "$env{FLEX_EXECUTABLE}",
      "BISON_EXECUTABLE": "$env{BISON_EXECUTABLE}",
      "FRUST_WINFLEXBISON_DIR": "$env{FRUST_WINFLEXBISON_DIR}"
    }
  }, {
    "name": "windows-release",
    "inherits": "windows-debug"
  }],
  "buildPresets": [{
    "name": "windows-debug",
    "configurePreset": "windows-debug",
    "configuration": "Debug",
    "targets": ["DjehutiResearch"],
    "jobs": 1
  }, {
    "name": "windows-release",
    "configurePreset": "windows-release",
    "configuration": "Release",
    "targets": ["DjehutiResearch"],
    "jobs": 1
  }]
}
